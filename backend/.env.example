# Supabase Transaction Pooler (port 6543). Keep sslmode=require.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Upstash/Redis TCP connection URL. Required by the separately hosted Celery worker.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
# Optional when the API is accessed directly from another browser origin.
CORS_ORIGINS=http://localhost:3000
