{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "client": {
      "root": "client/",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
