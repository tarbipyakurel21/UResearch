# Celery infrastructure. Use the same broker URL in server/.env.
CELERY_BROKER_URL=pyamqp://guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Server callback. JOBS_INTERNAL_SECRET must match server/.env.
WEBHOOK_BASE_URL=http://localhost:8000
JOBS_INTERNAL_SECRET=replace-with-the-same-random-secret-used-by-server

# S3-compatible object storage. These values must match server/.env.
AWS_ACCESS_KEY_ID=your-storage-access-key
AWS_SECRET_ACCESS_KEY=your-storage-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-private-bucket-name
CLOUDFLARE_BUCKET_NAME=your-public-bucket-hostname
UPLOAD_DIR=uploads

# AI providers used by background paper processing.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Periodic Zotero synchronization. Defaults to once every 24 hours.
ZOTERO_SYNC_INTERVAL_SECONDS=86400

# Optional telemetry and tracing.
POSTHOG_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

DEBUG=true
SERVICE_NAME=uresearch-jobs
LOG_LEVEL=INFO
